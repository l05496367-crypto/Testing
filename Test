        Widget.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Widget.Position
                movedDistance = 0
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                movedDistance = delta.Magnitude
                Widget.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        
        Widget.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    if movedDistance < 10 then
                        -- Restore to dead center when clicked
                        MainFrame.Position = UDim2.new(0.5, -290, 0.5, -180)
                        Widget:Destroy()
                        MainFrame.Visible = true
                        TopBanner.Visible = true
                        minimized = false
                        Sidebar.Visible = true
                        ContentArea.Visible = true
                        MainFrame.Size = UDim2.new(0, 580, 0, 360)
                        MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
                    end
                end
            end
        end)
    else
        MainFrame.Size = UDim2.new(0, 580, 0, 360)
        MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    end
end)

